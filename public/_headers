/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; media-src 'self' https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Content-addressed CSS/JS. A new build changes the path, so these can be
# cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data files are requested as /data/file.json?v=<sha256>. The client only
# reaches them through the manifest, so a versioned URL is immutable.
/data/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest is the one piece of data that must always be revalidated.
/data/manifest.json
  ! Cache-Control
  Cache-Control: no-store

# HTML and small metadata files revalidate on every navigation.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/play/*
  Cache-Control: no-cache

/normal/*
  Cache-Control: no-cache

/hard/*
  Cache-Control: no-cache

/practice/*
  Cache-Control: no-cache

/stats/*
  Cache-Control: no-cache

/archive/*
  Cache-Control: no-cache

/settings/*
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/build-summary.json
  Cache-Control: no-cache

/robots.txt
  Cache-Control: no-cache

/sitemap.xml
  Cache-Control: no-cache
