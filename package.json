{
  "name": "audio-birdle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Lint and unit-test tooling for the static Audio-Birdle client. The site itself is built by Python.",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint sitegen/static/js worker tests",
    "lint:css": "stylelint \"sitegen/static/css/**/*.css\"",
    "test:js": "node --test tests/js/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=24"
  }
}
