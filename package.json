{
  "name": "audio-birdle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run --config=vitest.config.js tests/unit",
    "test:integration": "vitest run --config=vitest.config.js tests/integration",
    "test:coverage": "vitest run --config=vitest.config.js --coverage",
    "test:watch": "vitest --config=vitest.config.js",
    "test:ui": "vitest --config=vitest.config.js --ui",
    "test:python": "pytest tests/ -v",
    "test:python-coverage": "pytest tests/ -v --cov=scripts --cov-report=html"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.4",
    "pytest": "^1.0.0",
    "pytest-cov": "^0.0.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
