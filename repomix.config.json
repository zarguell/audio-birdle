{
  "output": {
    "style": "markdown",
    "filePath": "repomix-output.md",
    "compress": false,
    "removeComments": true,
    "showLineNumbers": false,
    "topFilesLength": 20
  },
  "include": [
    "sitegen/**",
    "tests/**",
    "public/_headers",
    "README.md",
    "AGENTS.md",
    "demo-data/**"
  ],
  "ignore": {
    "customPatterns": [
      "**/*.svg"
    ]
  }
}
